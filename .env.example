# Copy to .env and fill in values. .env never goes into git.

# Database (PostGIS)
POSTGRES_DB=geo
POSTGRES_USER=geo
POSTGRES_PASSWORD=change-me
DB_PORT=5432
DATABASE_URL=postgresql://geo:change-me@db:5432/geo

# QGIS worker (MCP server)
MCP_URL=http://qgis:8100/mcp

# HIER EURE OPENROUTER KEYS EINTRAGEN
OPENROUTER_API_KEY=
# Key the backend uses to talk to the proxy; must start with sk- and can be anything
LITELLM_MASTER_KEY=sk-random-shit
LLM_BASE_URL=http://litellm:4000
LLM_MODEL=default

# Server only: domain for Caddy and HTTPS (locally: localhost)
DOMAIN=localhost
