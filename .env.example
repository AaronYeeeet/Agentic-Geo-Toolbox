# Copy to .env and adjust. `make dev` loads .env if it exists. Never commit real keys.

# Agent mode: mock (scripted demo agent); llm is not implemented yet
AGENT_MODE=mock

# Browser origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 1 removes the mock agent's artificial delays (tests, screenshots)
MOCK_FAST=0

# LLM agent (not implemented yet): leave unset
# LLM_PROVIDER=gemini
# LLM_MODEL=
# LLM_API_KEY=
# LLM_BASE_URL=
