# Kopie nach .env anlegen und Keys eintragen. .env niemals committen!

# ================= MODELL-UMSCHALTER =================
# Eine Zeile wählen (Rest bleibt auskommentiert). Danach Streamlit/Agent neu starten.
MODEL=gemma
# MODEL=flash-lite    # Google Gemini 3.5 Flash Lite (schnell)
# MODEL=nemotron      # OpenRouter: NVIDIA Nemotron 3.5 Super (free)
# MODEL=flint         # OpenRouter: Recursive AI Flint (free)
#
# gemma      = Google Gemma 4 31B          (braucht GEMINI_API_KEY)
# flash-lite = Google Gemini 3.5 Flash Lite (braucht GEMINI_API_KEY)
# nemotron   = NVIDIA Nemotron 3.5 Super    (braucht OPENROUTER_API_KEY)
# flint      = Recursive AI Flint           (braucht OPENROUTER_API_KEY)
# =====================================================

# Key von https://aistudio.google.com/apikey (kostenlos)
GEMINI_API_KEY=HIER_EINTRAGEN

# Key von https://openrouter.ai/keys  (Gratis-Modelle unter openrouter.ai/settings/privacy erlauben)
OPENROUTER_API_KEY=HIER_EINTRAGEN

# Optional
# QGIS_PROCESS=C:\Program Files\QGIS 3.44.15\bin\qgis_process-qgis-ltr.bat

# OSM-Daten: auto = lokale Geofabrik-Datei (data/osm), wenn sie das Gebiet abdeckt, sonst online (Overpass)
# OSM_SOURCE=auto
# LOCAL_OSM_BBOX=49.78,8.50,49.97,8.80
