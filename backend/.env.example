# ============================================================
# LLM configuration (provider-abstracted via LiteLLM)
# ============================================================
# Any model string LiteLLM understands works here.
#
#   Claude (cloud):   LLM_MODEL=anthropic/claude-opus-5-5     (most capable)
#                     LLM_MODEL=anthropic/claude-sonnet-5-5   (cheaper/faster)
#                     LLM_MODEL=anthropic/claude-haiku-5-5    (cheapest, weaker planning)
#   Free, cloud:      LLM_MODEL=gemini/gemini-3.5-flash       + GEMINI_API_KEY (aistudio.google.com)
#                     LLM_MODEL=groq/openai/gpt-oss-120b      + GROQ_API_KEY   (console.groq.com)
#   Free, local:      LLM_MODEL=ollama_chat/qwen3:8b          (needs a tool-calling model)
#                     LLM_API_BASE=http://localhost:11434
#
LLM_MODEL=anthropic/claude-opus-5-5

# API key for the provider in LLM_MODEL. Only the one you use needs a value;
# every line here is exported to the environment, where LiteLLM picks it up.
ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=

# Only needed for local providers (Ollama etc.). Leave empty otherwise.
LLM_API_BASE=

# Max tool-calling iterations per user message (safety limit).
AGENT_MAX_STEPS=12

# Comma-separated list of allowed CORS origins (the frontend dev server).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
